@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}

# ========================== AUTH ==========================
### REGISTRO
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "retr0lbb",
    "email": "retr0lbb@mail.com",
    "password": "123123"
}

### login
# @name login
POST  {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "retr0lbb@mail.com",
    "password": "123123"
}


# ========================== SPOT ==========================
### Criar spot
POST {{baseUrl}}/spots
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
    "lat": "4.2726784",
    "lon": "73.5132004",
    "alias": "Lake Chargoggagoggmanchauggagoggchaubunagungamaugg",
    "description": "Vista do lago Webster em massachusets. vista de cima do lago ideal para um piquenique",
    "address": "R. Royal vista, 1829. Aurora lane"
}

### Buscar spots por raio
# @name getSpot
GET {{baseUrl}}/spots?lat=4.2766985&lon=73.51321006&radius=5000

@SpotID = {{getSpot.response.body.spots.$[0].spot_id}}

### Atualizar spot
PUT {{baseUrl}}/spots/{{SpotID}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
    "alias": "Pico da neblina"
}

### Deletar spot
DELETE {{baseUrl}}/spots/{{SpotID}}
Authorization: Bearer {{login.response.body.accessToken}}


# ========================== IMAGENS DO SPOT ==========================
### Gerar presigned URL para upload
# @name presigned
POST {{baseUrl}}/spots/{{SpotID}}/image
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
    "mimeType": "image/jpg",
    "sizeBytes": 15728640,
    "originalName": "test.jpg"
    # "latitude": 4.2726784,
    # "longitude": 73.5132004
}

### Upload da imagem (cole a uploadUrl retornada acima)
PUT {{presigned.response.body.uploadUrl}}
Content-Type: image/jpg

< ./test.jpg

### Confirmar upload
POST {{baseUrl}}/spots/{{SpotID}}/image/{{presigned.response.body.imageId}}/confirm

### Listar imagens do spot
GET {{baseUrl}}/spots/{{SpotID}}/image

### DELETE AN IMAGE FROM A SPOT
DELETE  {{baseUrl}}/spots/{{SpotID}}/images/:imageId
Authorization: Bearer {{login.response.body.accessToken}}

# ========================== USUARIOS ==========================
### PEGA A INFORMACAO DOS USUARIOS
GET {{baseUrl}}/users
Authorization: Bearer {{login.response.body.accessToken}}

### PEGA TODOS OS USUARIOS HAHAHA
GET {{baseUrl}}/users/all

### DELETA UM USUARIO COM SUA FOTO DE PERFIL
DELETE {{baseUrl}}/users
Authorization: Bearer {{login.response.body.accessToken}}

###
# @name picture
POST {{baseUrl}}/users/picture
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "mimeType": "image/webp",
  "sizeBytes": 21024,
  "originalName": "reggie.webp"
}

### Upload da imagem
PUT {{picture.response.body.url}}
Content-Type: image/webp

< ./reggie.webp


### CONFIRM USER PROFILE PICTURE UPLOAD
POST {{baseUrl}}/users/picture/confirm
Authorization: Bearer {{login.response.body.accessToken}}


### GET ALL PICS
GET {{baseUrl}}/users/pics

### DELETE ALL
DELETE {{baseUrl}}/users/pics